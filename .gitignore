# OS
.DS_Store
Thumbs.db
nul

# IDE
.idea/
.vscode/
*.swp
*.swo

# Claude Code (ignore all except rules, settings, agents, skills, hooks)
.claude/*
!.claude/rules.md
!.claude/settings.json
!.claude/agents/
!.claude/skills/
!.claude/hooks/

# Flutter / Dart
apps/mobile/.dart_tool/
apps/mobile/.packages
apps/mobile/build/
apps/mobile/.flutter-plugins
apps/mobile/.flutter-plugins-dependencies
*.iml

# Bun / Node
apps/server/node_modules/

# MCP config (contains connection strings)
.mcp.json

# Environment
.env
.env.*
!.env.example

# Firebase credentials
**/google-services.json
**/firebase-service-account.json

# Android signing
key.properties
*.jks
*.keystore

# Generated
*.g.dart
*.freezed.dart
*.gr.dart

# Playwright MCP
.playwright-mcp/

# Screenshots / verification artifacts (track images/ for reference screenshots)
*.png
*.jpeg

# Allow Android launcher icons
!apps/mobile/android/app/src/main/res/mipmap-*/ic_launcher.png

# Debug logs (track docs/debug/.gitkeep to preserve folder)

# Prompt templates (personal workflow aids)
prompts/

# Misc
*.log
