{
  "name": "cricapp-server",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "db:generate": "bunx drizzle-kit generate",
    "db:migrate": "bunx drizzle-kit migrate",
    "db:seed": "bun run src/db/seed/master_data.ts",
    "typecheck": "bunx tsc --noEmit"
  },
  "dependencies": {
    "elysia": "^1.2.12",
    "drizzle-orm": "^0.38.4",
    "postgres": "^3.4.5",
    "firebase-admin": "^13.0.2"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "drizzle-kit": "^0.30.4",
    "typescript": "^5.7.3"
  }
}
