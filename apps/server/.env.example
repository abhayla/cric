# Database
DATABASE_URL=postgresql://user:password@localhost:5432/cricapp_dev

# Firebase
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# Server
PORT=3000
WS_PORT=3001
CORS_ORIGIN=*
NODE_ENV=development
LOG_LEVEL=debug

# File uploads
UPLOADS_DIR=./uploads
MAX_UPLOAD_SIZE_MB=1

# Sync
SYNC_BATCH_SIZE=50
WS_HEARTBEAT_INTERVAL_MS=30000
